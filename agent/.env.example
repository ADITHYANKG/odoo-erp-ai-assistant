# Odoo MCP endpoint (Model Context Protocol, Streamable HTTP).
# Local default; switch to the public tunnel URL to test the internet path.
MCP_URL=http://127.0.0.1:8069/mcp

# muk_mcp bearer key. Mint one with:
#   python ../odoo-setup/4_create_mcp_key.py
# (the plaintext is shown exactly once)
MCP_BEARER_KEY=

# OpenRouter — the ONLY LLM provider this project uses (see CLAUDE.md).
# Key: https://openrouter.ai/keys. Model is runtime config, never hardcoded.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# OpenAI-compatible base URL for every OpenRouter call (chat + embeddings).
# Example: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# Optional server-side failover (comma-separated, tried in order when the
# primary model's providers are down/rate-limited). Pick tool-capable models.
# Example: deepseek/deepseek-v4-flash-0731
OPENROUTER_FALLBACK_MODELS=

# Telegram bot (phase 3) — token from @BotFather.
TELEGRAM_BOT_TOKEN=

# OAuth client for per-user login. Register with:
#   python ../odoo-setup/5_create_agent_oauth_client.py
OAUTH_CLIENT_ID=

# Where the agent's OAuth callback server listens (browser must reach it).
# Local dev default; use a public URL when executives log in from phones.
AGENT_PUBLIC_URL=http://localhost:8181

# Browser-facing Odoo base URL (defaults to MCP_URL minus /mcp).
# Example: http://localhost:8069
ODOO_PUBLIC_URL=

# Max LangGraph steps per question (the runaway-loop ceiling; default 16).
# Middleware nodes count too: one tool round costs ~4 steps, so budget
# 4x the tool rounds you want (64 ~= 16 rounds). Raise if legitimate
# questions hit "required more steps than allowed".
# Example: 64
AGENT_RECURSION_LIMIT=

# Edit the Telegram placeholder with generated text about twice per second.
# The completed answer still replaces it with fully formatted text. Set to 0
# to restore the original placeholder-to-final one-shot behavior.
# Example: 1
AGENT_TOKEN_STREAMING=

# WhatsApp Cloud API channel. Set ALL FOUR to turn it on (a partial set stops
# startup); leave them all unset and WhatsApp stays off.
#   WHATSAPP_VERIFY_TOKEN  any string you choose; paste the same one into Meta's
#                          webhook settings (GET handshake on /webhook/whatsapp)
#   WHATSAPP_APP_SECRET    Meta app → Settings → Basic; signs every webhook POST
#   WHATSAPP_ACCESS_TOKEN  System User token (the 24h test token expires)
#   WHATSAPP_PHONE_NUMBER_ID  WhatsApp → API Setup
# Webhook URL to give Meta: ${AGENT_PUBLIC_URL}/webhook/whatsapp, field "messages".
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Digits of the business number; powers the "Return to WhatsApp" link after login.
WHATSAPP_BUSINESS_NUMBER=
# Graph API version (default v23.0).
# Example: v23.0
WHATSAPP_API_VERSION=
# Sender numbers allowed to talk to the bot, with country code, comma separated.
# Empty = anyone (the Meta test number already limits this to its recipient list).
# Example: 919876543210,14155550123
AGENT_ALLOWED_WHATSAPP_NUMBERS=

# Google Chat channel (HTTP-endpoint Chat app, direct messages only). Set BOTH
# of the first two to turn it on (a partial set stops startup); leave them
# unset and Google Chat stays off.
#   GOOGLE_CHAT_PROJECT_NUMBER    Google Cloud project NUMBER (digits, not the id);
#                                 Cloud console → project dashboard. Google signs
#                                 every event as service-<number>@gcp-sa-gsuiteaddons...
#   GOOGLE_CHAT_CREDENTIALS_FILE  service-account JSON key the bot replies with
#                                 (relative paths are under the repo root; keep it
#                                 out of git, e.g. secrets/googlechat-sa.json)
# Endpoint URL to give Google: ${AGENT_PUBLIC_URL}/webhook/googlechat
GOOGLE_CHAT_PROJECT_NUMBER=
# Example: secrets/googlechat-sa.json
GOOGLE_CHAT_CREDENTIALS_FILE=
# Only if the URL entered in the Chat API console differs from the one above
# (it must match EXACTLY, trailing slash included - Google signs it as the audience).
GOOGLE_CHAT_ENDPOINT_URL=
# Workspace emails allowed to talk to the bot, comma separated. Empty = anyone
# the Chat app is shared with.
# Example: priya@acme.com,bob@acme.com
AGENT_ALLOWED_GOOGLE_CHAT_EMAILS=

# Slack channel (direct messages only). Socket Mode by default: the agent connects
# out, so no public URL is needed. Leave SLACK_BOT_TOKEN unset and Slack stays off.
#   SLACK_BOT_TOKEN  Bot User OAuth Token (xoxb-), Install App page
#   SLACK_APP_TOKEN  App-level token (xapp-) with connections:write
# Append these lines to the server's .env; do not rewrite the file (keeps owner/mode).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# HTTP mode instead: SLACK_MODE=http plus the Signing Secret; endpoint ${AGENT_PUBLIC_URL}/webhook/slack
# Example: socket
SLACK_MODE=
SLACK_SIGNING_SECRET=
# Slash command name, used in help text if you renamed it in the manifest.
# Example: /odoo
SLACK_COMMAND=
# Member ids (U...) allowed to use the bot; empty = everyone in your workspace.
# Example: U0123ABCD
AGENT_ALLOWED_SLACK_USERS=
# Extra workspace ids (T...) whose members may use it (Slack Connect); empty = own workspace only.
AGENT_ALLOWED_SLACK_TEAMS=
# false = answer unconnected people with the login button instead of staying silent.
# Example: true
AGENT_SLACK_SILENT_UNTIL_LOGIN=
# Largest audio clip (MB) that will be transcribed.
# Example: 2
AGENT_SLACK_VOICE_MAX_MB=

# Langfuse tracing/observability (self-hosted UI at http://localhost:3000).
# Create a project there, then Settings → API Keys. Leave empty = tracing off.
# Bot in Docker on the server: LANGFUSE_BASE_URL="http://172.17.0.1:3000"
# (see deploy/langfuse/README.md).
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="http://localhost:3000"

# Error tracking: Sentry (sentry.io) or a self-hosted Sentry-compatible server
# such as GlitchTip. Every error the bot logs (failed turns, briefs, watchers,
# uploads, voice notes, handler crashes) becomes an issue with its traceback.
# Empty = off. Request bodies, local variables, e-mail addresses and
# credentials are stripped before anything is sent (see errortracking.py).
SENTRY_DSN=
# Separates the test server from production in the Sentry UI.
# Example: development
SENTRY_ENVIRONMENT=
# Optional release name (e.g. the git sha from CI); defaults to the package version.
SENTRY_RELEASE=

# Abuse backstop: max NEW questions one ODOO USER may ask per day (default
# 200 — generous; resolving a pending approval is never blocked). Keyed by
# login, so the same person in two chats shares one budget.
# Example: 200
AGENT_DAILY_MESSAGE_LIMIT=

# Real-dollar cap per Odoo user per day (OpenRouter's actual billed cost, not
# an estimate). Unset = disabled. A user over the cap is refused before the
# next question runs any LLM call.
# Example: 5.00
AGENT_DAILY_SPEND_LIMIT_USD=

# Real-dollar cap across ALL users per day. The per-user cap above bounds one
# person; this bounds the bill, which is otherwise per-user cap x however many
# people have connected. Unset = disabled.
# Example: 25.00
AGENT_GLOBAL_DAILY_SPEND_LIMIT_USD=

# Burst guard: messages one Telegram SENDER may send per window before being
# throttled. The daily caps bound a day; without this, 200 paid model calls
# can still go through in one minute. Over the limit the bot warns once, then
# stays silent until the window clears. 0 disables the guard.
# Example: 10
AGENT_BURST_LIMIT=
# Example: 60
AGENT_BURST_WINDOW_SECONDS=

# Wall-clock ceiling on one chat turn, in seconds. Each chat's messages are
# handled one at a time, so a turn stuck on a network call that never returns
# would block that chat until a restart; past this limit the user gets an
# apology and the chat is freed. 0 disables the limit.
# Example: 300
AGENT_TURN_TIMEOUT_SECONDS=

# Numeric Telegram user ids allowed to talk to the bot AT ALL, comma
# separated. Empty = anyone may start a login. Unlike the group check below
# this blocks strangers BEFORE they reach the Odoo login page; unknown senders
# get no reply at all. Find an id by messaging @userinfobot on Telegram.
# Example: 123456789,987654321
AGENT_ALLOWED_TELEGRAM_IDS=

# Odoo group a user must belong to before a chat can be bound. Empty = any
# internal Odoo user may connect. Create the group in Odoo (Settings → Users &
# Companies → Groups) and put its name here; access is then managed in Odoo
# alone, so offboarding there cuts the bot off too. Match the name whoami
# reports: "Category / Name" for a categorised group, the plain name if it has
# no category.
# Example: "AI Assistant Users"
AGENT_REQUIRED_ODOO_GROUP=

# Rotating log files (5 MB x 5 backups), relative to the repo root. Empty = terminal
# only. The blocked file gets only messages dropped by the allowlist above;
# they also appear in the main file.
# Example: logs/agent.log
AGENT_LOG_FILE=
# Example: logs/blocked.log
AGENT_BLOCKED_LOG_FILE=

# Long-term memory: preferences remembered per ODOO USER, surviving /new and
# /logout (use /forget to erase them). Set to 0 to disable entirely.
# Example: 1
AGENT_LONG_TERM_MEMORY=

# OpenRouter embedding model used to search those preferences. Empty
# disables semantic search (memory still works, recall just lists).
# CHANGE DIMS TOGETHER WITH THE MODEL — they must match, or the vector
# index is corrupt (text-embedding-3-small = 1536, qwen3-0.6b = 1024).
# Leave this line commented out to use the default; an empty value turns memory search off.
#AGENT_MEMORY_EMBED_MODEL=openai/text-embedding-3-small
# Example: 1536
AGENT_MEMORY_EMBED_DIMS=

# How many stored preferences are injected into one prompt.
# Example: 10
AGENT_MEMORY_MAX_RECALL=

# Conversation summarization: compress a thread past this many tokens,
# keeping the most recent N messages verbatim. Keep the trigger FAR above
# one busy turn — at 3000 the summarizer fired mid-turn and ate the user's
# own question (live bug, 2026-08-19).
# Example: 60000
AGENT_SUMMARY_TRIGGER_TOKENS=
# Example: 20
AGENT_SUMMARY_KEEP_MESSAGES=

# --- Proactive: morning brief and watchers ---------------------------------
# Master switch for everything the bot does unprompted. 0 = purely reactive.
# Example: 1
AGENT_PROACTIVE=

# When the daily brief lands, in EACH USER's own timezone (read from their
# Odoo profile at login), so one bot serves people in different regions.
# Example: 8
AGENT_BRIEF_HOUR=
# Example: 0
AGENT_BRIEF_MINUTE=

# A brief missed because the machine was asleep is still worth sending a few
# hours late; one missed all day is noise. 0 disables catch-up entirely.
# Example: 4
AGENT_BRIEF_CATCHUP_HOURS=

# Fallback when an Odoo user has no timezone set.
# Example: "Asia/Kolkata"
AGENT_DEFAULT_TIMEZONE=

# Watchers: how often each standing condition is re-checked, and how many one
# user may have. Every check is one model call, so cost is roughly
# watchers x users x (1440 / interval) per DAY - this is the single biggest
# cost driver in the bot, and the one that scales with headcount. At the
# 480-minute default that is 3 checks per watcher per day. Shortening it
# multiplies the bill: 60 minutes is 8x this. Raise the spend caps first.
# Example: 480
AGENT_WATCHER_INTERVAL_MINUTES=
# Example: 5
AGENT_MAX_WATCHERS_PER_USER=

# How often the scheduler looks for due work. Finer than any schedule it
# serves - it decides what is due, it is not itself the schedule.
# Example: 300
AGENT_TICK_SECONDS=

# --- Voice questions -------------------------------------------------------
# Telegram voice notes are transcribed through OpenRouter's
# /audio/transcriptions endpoint (NOT chat/completions - a transcription
# model is rejected there). Telegram's OGG/Opus is accepted as-is, so no
# ffmpeg is needed. 0 makes the bot decline voice notes politely.
# Example: 1
AGENT_VOICE=
# Example: openai/gpt-transcribe
AGENT_TRANSCRIBE_MODEL=
# Longer notes are refused before download, bounding cost and memory.
# Example: 120
AGENT_VOICE_MAX_SECONDS=

# --- Uploaded images and PDF files -----------------------------------------
# Photos and PDF files sent in chat are read by the model itself: OpenRouter
# parses PDFs server-side, so no PDF library is installed here. 0 makes the
# bot decline files politely.
# Example: 1
AGENT_UPLOADS=
# Refused before download, so an oversized file costs nothing. Telegram's
# getFile caps downloads at 20 MB regardless, and a PDF's cost scales with
# its page count.
# Example: 5
AGENT_UPLOAD_MAX_MB=
# Fallback models for turns carrying a FILE - deliberately separate from
# OPENROUTER_FALLBACK_MODELS, and empty by default. Most models cannot read
# an image or a PDF, and one that cannot does not error: it answers from the
# caption alone, sounding confident about a document it never saw. List only
# models verified to accept image and file input. Same 3-entry ceiling.
AGENT_UPLOAD_FALLBACK_MODELS=
# OpenRouter's PDF parsing engine. Empty uses their default; named engines
# (for example mistral-ocr) are charged per thousand pages.
AGENT_UPLOAD_PDF_ENGINE=

# --- Agent datastore -------------------------------------------------------
# Postgres for conversation memory and long-term preferences, from
# docker-compose.yaml. Its OWN database, not Odoo's: the agent is a
# standalone service, and a client may run Odoo Online or odoo.sh where
# creating a database on their server is not an option.
# REQUIRED - there is no SQLite fallback. Everything the agent persists
# lives here: bindings and credentials, usage counters, the action log,
# watchers, conversation checkpoints and preferences.
#
#     docker compose up -d db
#
# 127.0.0.1 rather than localhost, deliberately: Windows resolves localhost
# to ::1 first, Docker publishes the port on IPv4 only, and the connection
# then hangs until it times out with no useful error.
AGENT_DB_URL=postgresql://ont_agent:ont_agent@127.0.0.1:5566/ont_agent

# The tests need Postgres too, and each one runs in its own schema. Defaults
# to the DSN above; point it elsewhere to keep test data off a live database.
AGENT_TEST_DB_URL=

# Refresh an access token this many seconds BEFORE Odoo expires it.
# Must outlast a whole turn, not a median one: the token is checked once
# when a turn starts and then used for every tool call in it, and nothing
# recovers from a 401 partway through - the tool simply fails and the answer
# degrades with no sign of why. Clamped to half the token's life, so a short
# ont_mcp_oauth.access_token_ttl cannot be swallowed whole.
# Example: 300
AGENT_TOKEN_REFRESH_MARGIN_SECONDS=

# --- Retention -------------------------------------------------------------
# Delete a conversation thread this many days after its last message. 30
# because that is when the LOGIN dies anyway (the OAuth server's
# refresh_token_ttl_days is 30), so retention can never discard a
# conversation a working login could still have used. 0 disables it.
# Example: 30
AGENT_CONVERSATION_RETENTION_DAYS=
# Delete usage counters older than this. Every read is for a SINGLE day, so
# history is never consulted - but the weekly digest reads the user's LOCAL
# day, which can sit either side of UTC, so never make this tiny.
# Example: 90
AGENT_USAGE_RETENTION_DAYS=

# --- model latency recording (metrics.py) ------------------------------------
# One row per model call in the llm_calls table: which model answered, which
# provider served it, how long it took, tokens and cost. This is the standing
# evidence behind "which model is fast?" - run `uv run ont-agent-latency` to
# read it back. Written by a background worker, so it never delays an answer.
# Example: true
AGENT_LLM_METRICS=
# Ask OpenRouter for its OWN timings (GET /generation) after each call. This
# remains the source of provider-side time to first token. Telegram token
# streaming measures when text reaches the bot, which also includes network
# and graph overhead. The endpoint returns metadata rather than inference, so
# it costs no tokens. Turning it off drops the provider timing column.
# Example: true
AGENT_LLM_STATS_FETCH=
# How long to wait before asking. OpenRouter writes that row a beat after the
# completion returns, so asking immediately gets a 404 for a generation that
# certainly exists.
# Example: 1500
AGENT_LLM_STATS_DELAY_MS=
# Attempts before giving up and storing the row without OpenRouter's numbers.
# Each attempt waits longer than the last (1.5s, 3s, 4.5s...), so five cover
# about 22 seconds. A long answer's row takes longer to appear than a short
# one's, and long answers are the slow ones worth measuring.
# Example: 5
AGENT_LLM_STATS_ATTEMPTS=
# Samples that may wait to be written. Bounded on purpose: while OpenRouter is
# unreachable the worker stalls on retries while calls keep finishing, and an
# unbounded queue would make a measurement feature a memory leak. Overflow
# drops samples and logs a count.
# Example: 500
AGENT_LLM_METRICS_QUEUE_MAX=
# Delete latency rows older than this. Matches usage retention, but note this
# is one row per CALL rather than per day - several per question.
# Example: 90
AGENT_LLM_METRICS_RETENTION_DAYS=
# Start a fresh conversation thread once the current one holds this many
# checkpoints, carrying the state across so the user notices nothing.
# Retention above only deletes IDLE threads, so an active user's thread
# would otherwise grow forever (~60 checkpoints a day at ~100 KB each).
# 100 is about 33 turns. Rotating costs no model call, so low is cheap.
# 0 disables it.
# Example: 100
AGENT_THREAD_MAX_CHECKPOINTS=

# --- Connection pools ------------------------------------------------------
# Two pools: LangGraph's (checkpoints + long-term memory, the heavy writer)
# and BindingStore's own, which does short queries and is capped smaller.
# A pool rather than one shared connection is a CORRECTNESS requirement:
# a psycopg transaction is connection-scoped, and the handlers, the
# proactive ticker and the callback server all use the store at once.
# Example: 1
AGENT_DB_POOL_MIN_SIZE=
# Example: 8
AGENT_DB_POOL_MAX_SIZE=
# Example: 4
AGENT_STORE_POOL_MAX_SIZE=

# --- Group chats -----------------------------------------------------------
# How long a group is remembered as already told this bot is private-only,
# so it is not re-notified on every message. A window rather than a size
# cap because it self-empties; a group re-added later gets one more notice.
# Example: 3600
AGENT_GROUP_NOTICE_TTL_SECONDS=

# --- Quiet hours -----------------------------------------------------------
# Local hours between which the bot sends nothing unprompted. Briefs already
# wait for AGENT_BRIEF_HOUR in the USER's timezone, but watcher checks were
# pure interval arithmetic - at an 8-hour interval one of the three daily
# checks lands in their night by construction, and a 3am alert is the
# fastest way to get a bot muted.
#
# A watcher due during these hours is SKIPPED, not suppressed: it stays due
# and fires when their day starts, so nothing is lost. The window wraps
# midnight. Equal values disable it.
# Example: 21
AGENT_QUIET_HOURS_START=
# Example: 8
AGENT_QUIET_HOURS_END=

# --- System-prompt guardrail -----------------------------------------------
# Refuses messages asking for the agent's own configuration, and replaces
# any reply that reproduces it. Three layers, none costing a model call: a
# confidentiality rule in the prompt (handles paraphrase), pattern matching
# on the way in (refuses before anything is billed), and an n-gram scan on
# the way out (the only one a rephrasing cannot bypass).
#
# It does NOT make the prompt secret - the security model does not depend
# on that. Every real control is server-side.
# Example: true
AGENT_PROMPT_GUARD=
# Consecutive words of the prompt that must appear in a reply before it
# counts as a leak. Lower catches more and risks flagging an honest answer
# that echoes a rule; higher lets partial reproduction through.
# Example: 12
AGENT_PROMPT_LEAK_NGRAM=

# Redact credentials out of tool results and replies. The primary hook is
# TOOL RESULTS, before the model sees them: a key pasted into a partner
# note would otherwise reach the reply, the conversation checkpoint (kept
# 30 days) and the Langfuse trace at once. Patterns are anchored on vendor
# prefixes (sk-, AKIA, ghp_, eyJ...) - no entropy heuristics, which would
# eat invoice references, SKUs and attachment checksums.
# Example: true
AGENT_SECRET_SCAN=

# Sender name shown in the email approval preview. Set it to the Odoo system
# parameter ont_mcp_mail.sender_name (default there: "<Company> AI Assistant").
# Example: "Acme AI Assistant"
AGENT_MAIL_SENDER_NAME=

# --- Token encryption ------------------------------------------------------
# Encrypts the OAuth access/refresh tokens stored in agent.db. Empty leaves
# them in PLAINTEXT (a startup warning says so). Protects backups, disk
# images and cloud-sync copies of the database - NOT an attacker already on
# the running host, who can read this file too. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it means every user must reconnect with /start.
AGENT_TOKEN_KEY=

# --- Web server (OAuth callback and webhooks) ------------------------------
# Address the bot's own HTTP server listens on. AGENT_PUBLIC_URL is the
# public URL that reaches it (through a tunnel or reverse proxy). In Docker,
# set CALLBACK_HOST=0.0.0.0 so the port is reachable from outside the container.
# Example: localhost
CALLBACK_HOST=
# Example: 8181
CALLBACK_PORT=

# --- Answers ---------------------------------------------------------------
# Turn record names in answers into links back into Odoo (needs ODOO_PUBLIC_URL).
# Example: true
AGENT_DEEP_LINKS=

# --- Semantic router -------------------------------------------------------
# Answers greetings and other fixed questions locally, without an LLM call,
# using a small FastEmbed (ONNX) model. Off by default.
# Example: false
AGENT_SEMANTIC_ROUTER=
# Example: sentence-transformers/all-MiniLM-L6-v2
AGENT_SEMANTIC_ROUTER_MODEL=
# Similarity a message needs to match a route (0-1). Higher = fewer matches.
# Example: 0.55
AGENT_SEMANTIC_ROUTER_THRESHOLD=

# --- Weekly digest ---------------------------------------------------------
# Weekly "what I did" digest, and how many days its action log is kept.
# Example: true
AGENT_DIGEST=
# Example: 90
AGENT_ACTION_LOG_DAYS=

# --- Logging ---------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR.
# Example: INFO
LOG_LEVEL=

# --- Jenkins (only for the `python -m ont_agent.jenkins` connectivity check) -
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
